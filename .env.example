# =============================================================================
# Kankali multi-user — Environment Variables
# Set these in Vercel Project → Settings → Environment Variables
# =============================================================================

# --- NextAuth / Google OAuth ---
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# --- Firebase Admin (service account) ---
# Prefer a single JSON blob (stringified serviceAccount.json):
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# OR individual fields:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Encrypt GitHub PATs at rest (AES-256-GCM) ---
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# --- OAuth 2.1 Access Token JWT Signing (HS256) ---
JWT_SIGNING_SECRET=generate-with-openssl-rand-hex-32

# --- Gmail for expiry reminder emails ---
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Cron protection (Vercel Cron sends Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=openssl-rand-hex-16

# APP_URL used in email links (defaults to NEXTAUTH_URL)
# APP_URL=https://your-app.vercel.app
